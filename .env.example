# Ví dụ không chứa secret. npm run setup tự tạo .env riêng, không ghi đè file đã có.
DATABASE_URL=postgresql://codex@127.0.0.1:55434/project_codex_dev
TEST_DATABASE_URL=postgresql://codex@127.0.0.1:55434/project_codex_test
PORT=4100
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=
ADMIN_EMAIL=admin@project-codex.local
ADMIN_PASSWORD=
# loopback cho proxy cục bộ; gateway cho Vercel proxy đã xác thực.
TRUST_PROXY=
# Các biến production, không cần cho dev. URL/secret cấp qua hosting, không commit giá trị.
EXPECTED_DATABASE_NAME=
HOST=127.0.0.1
DATABASE_POOL_MAX=5
# verify-full cho Neon; disable chỉ dành DB loopback phát triển.
DATABASE_SSL=
DATABASE_CA_CERT=
API_PROXY_SECRET=
