# Mẫu production, không có credential. Cấp qua Render/Vercel; không copy .env phát triển.
NODE_ENV=production
HOST=0.0.0.0
PORT=4100
DATABASE_URL=
EXPECTED_DATABASE_NAME=neondb
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=5
WEB_ORIGIN=https://your-project.vercel.app
SESSION_SECRET=
TRUST_PROXY=gateway
API_PROXY_SECRET=
# Chỉ cấp cho initialize job, không cần giữ trong service runtime.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Bật1 cho first boot nếu chưa chạy initialize job; sau đó bỏ admin keys/flag ở hosting và redeploy.
INITIALIZE_DEMO=0
# Chỉ Vercel function đọc URL này; không dùng biến VITE cho secret.
API_BACKEND_URL=https://your-service.onrender.com
